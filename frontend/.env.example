# Local development can use the Vite proxy and leave VITE_API_URL unset.
# Set this in Vercel to the deployed FastAPI service URL, without a trailing slash.
VITE_API_URL=https://voiceguard-ai-api.onrender.com

# Optional override. By default the frontend derives ws:// or wss:// from VITE_API_URL.
# VITE_WS_URL=wss://voiceguard-ai-api.onrender.com
