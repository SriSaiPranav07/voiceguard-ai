# Leave both unset for the same-origin Vercel FastAPI deployment and local Vite proxy.
# For a separately hosted backend, set these to its HTTP and WebSocket origins.
# VITE_API_URL=https://your-api-host.example

# Optional; by default the frontend derives ws:// or wss:// from VITE_API_URL.
# VITE_WS_URL=wss://your-api-host.example
